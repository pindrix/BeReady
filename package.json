  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:ui",
    "test:unit": "node --import tsx --test --test-isolation=none tests/*.test.ts",
    "test:ui": "jest --runInBand",
    "export:mobile": "expo export --platform android --platform ios --max-workers 2",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "visual:preview": "node scripts/visual-preview.mjs",
    "visual:capture": "node scripts/visual-preview.mjs --capture",
    "i18n:check": "node scripts/check-translations.mjs",
    "i18n:extract": "node scripts/extract-messages.mjs"
  },
  "private": true,
  "engines": {
    "node": ">=24 <25"
  }
